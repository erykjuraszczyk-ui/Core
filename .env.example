# Server-only Cloudflare Pages Functions variables/secrets.
# Never prefix these with VITE_ and never expose them to browser bundles.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_REDIRECT_URI=
# Generate 32 random bytes and encode as base64url; store as a Cloudflare secret.
AUTH_SESSION_ENCRYPTION_KEY=
# Optional:
# AUTH_COOKIE_NAME=__Host-cortana_session
# AUTH_SESSION_TTL_SECONDS=1209600
# AUTH_SCOPE=openid profile email offline_access
